# AI provider (any OpenAI-compatible API). Defaults work without this file:
# local Ollama on http://localhost:11434/v1 with llama3.2:3b.
VITE_AI_BASE_URL=http://localhost:11434/v1
VITE_AI_MODEL=llama3.2:3b
VITE_AI_API_KEY=ollama

# GROQ instead:
# VITE_AI_BASE_URL=https://api.groq.com/openai/v1
# VITE_AI_MODEL=openai/gpt-oss-20b
# VITE_AI_API_KEY=<your-groq-key>

# OpenRouter instead:
# VITE_AI_BASE_URL=https://openrouter.ai/api/v1
# VITE_AI_MODEL=<model-id>
# VITE_AI_API_KEY=<your-openrouter-key>
